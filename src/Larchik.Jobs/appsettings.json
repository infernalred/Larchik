{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ]
  },
  "BackgroundJobs": {
    "Enabled": true,
    "SchedulerPollSeconds": 30,
    "ExecutorPollSeconds": 10,
    "ExecutorBatchSize": 5,
    "FxCbrDaily": {
      "Enabled": true,
      "HourUtc": 5,
      "MinuteUtc": 10,
      "MaxAttempts": 8,
      "RetryDelayMinutes": 20,
      "LockTimeoutMinutes": 5
    },
    "MoexPricesDaily": {
      "Enabled": false,
      "HourUtc": 19,
      "MinuteUtc": 20,
      "MaxAttempts": 8,
      "RetryDelayMinutes": 20,
      "LockTimeoutMinutes": 10,
      "Provider": "MOEX",
      "BaseUrl": "https://iss.moex.com/iss",
      "Boards": [ "TQBR", "TQTF", "TQIF", "TQCB", "TQOB" ]
    },
    "TbankPricesDaily": {
      "Enabled": true,
      "HourUtc": 21,
      "MinuteUtc": 0,
      "MaxAttempts": 8,
      "RetryDelayMinutes": 20,
      "LockTimeoutMinutes": 20,
      "Provider": "TBANK",
      "BaseUrl": "https://invest-public-api.tbank.ru/rest/tinkoff.public.invest.api.contract.v1.MarketDataService/GetCandles",
      "AccruedInterestsBaseUrl": "https://invest-public-api.tbank.ru/rest/tinkoff.public.invest.api.contract.v1.InstrumentsService/GetAccruedInterests",
      "Token": "",
      "AllowInvalidTls": false,
      "MaxHistoryLookbackDays": 7,
      "MaxParallelism": 6,
      "CountryExclusions": []
    },
    "TbankInstrumentInfoDaily": {
      "Enabled": false,
      "HourUtc": 20,
      "MinuteUtc": 30,
      "MaxAttempts": 8,
      "RetryDelayMinutes": 20,
      "LockTimeoutMinutes": 20,
      "BaseUrl": "https://invest-public-api.tbank.ru/rest/tinkoff.public.invest.api.contract.v1.InstrumentsService/GetInstrumentBy",
      "Token": "",
      "AllowInvalidTls": false,
      "MaxParallelism": 6,
      "CountryExclusions": []
    }
  },
  "MarketDataImports": {
    "ChunkDays": 90,
    "MaxAttempts": 5,
    "DefaultCategoryId": 14,
    "EtfCategoryId": 22
  },
  "MarketDataImportSources": {
    "Moex": {
      "BaseUrl": "https://iss.moex.com/iss"
    },
    "Tbank": {
      "FindInstrumentBaseUrl": "https://invest-public-api.tbank.ru/rest/tinkoff.public.invest.api.contract.v1.InstrumentsService/FindInstrument",
      "CandlesBaseUrl": "https://invest-public-api.tbank.ru/rest/tinkoff.public.invest.api.contract.v1.MarketDataService/GetCandles",
      "AccruedInterestsBaseUrl": "https://invest-public-api.tbank.ru/rest/tinkoff.public.invest.api.contract.v1.InstrumentsService/GetAccruedInterests",
      "Token": ""
    }
  },
  "RabbitMq": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "larchik.market-data",
    "Queue": "larchik.market-data.import",
    "RetryQueue": "larchik.market-data.import.retry",
    "DeadLetterQueue": "larchik.market-data.import.dead",
    "RoutingKey": "market-data.import",
    "RetryRoutingKey": "market-data.import.retry",
    "DeadLetterRoutingKey": "market-data.import.dead",
    "RetryDelaySeconds": 60,
    "OutboxPollSeconds": 2,
    "OutboxBatchSize": 20,
    "PrefetchCount": 1,
    "ReconnectDelaySeconds": 5
  }
}
